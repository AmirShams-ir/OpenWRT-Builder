config wifi-device 'radio0'
	option type 'mac80211'
	option path 'pci0000:00/0000:00:1e.0/0000:03:00.0'
	option band '2g'
	option channel '1'
	option htmode 'HT20'
	option disabled '0'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Smart-Net'
	option encryption 'psk2'
	option disabled '0'
	option key '__SMARTNET_WIFI_KEY__'
