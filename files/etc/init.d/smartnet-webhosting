#!/bin/sh /etc/rc.common
# procd service wrapper for the optional per-app runtime supervisor.
# Static apps do not require this service; Docker/container management is
# intentionally handled by the separate Docker module/runtime.
USE_PROCD=1
START=95
STOP=10

start_service() {
    # Keep the service inert until a verified native Node runtime and an
    # explicit server entrypoint are installed. Never guess an ABI/runtime.
    [ -x /usr/bin/node ] || return 0
    [ -f /home/smartnet/webhosting/runtime/server.js ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/node /home/smartnet/webhosting/runtime/server.js
    procd_set_param respawn 3600 5 5
    procd_set_param file /home/smartnet/webhosting/runtime/server.js
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
